<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:body><office:presentation>
<draw:page draw:name="Дорожная карта">
<draw:frame presentation:class="title" presentation:placeholder="true" svg:width="24cm" svg:height="3cm" svg:x="2cm" svg:y="1cm"><draw:text-box><text:p>Дорожная карта</text:p></draw:text-box></draw:frame>
<draw:frame presentation:class="outline" presentation:placeholder="true" svg:width="24cm" svg:height="10cm" svg:x="2cm" svg:y="5cm"><draw:text-box><text:p>Кодовое имя Q4 — ЛАВИНА</text:p><text:p>Запуск в ноябре</text:p></draw:text-box></draw:frame>
<presentation:notes><draw:frame presentation:class="notes" svg:width="15cm" svg:height="10cm" svg:x="2cm" svg:y="12cm"><draw:text-box><text:p>Сказать про бюджет</text:p></draw:text-box></draw:frame></presentation:notes>
</draw:page><draw:page draw:name="Команда">
<draw:frame presentation:class="title" presentation:placeholder="true" svg:width="24cm" svg:height="3cm" svg:x="2cm" svg:y="1cm"><draw:text-box><text:p>Команда</text:p></draw:text-box></draw:frame>
<draw:frame presentation:class="outline" presentation:placeholder="true" svg:width="24cm" svg:height="10cm" svg:x="2cm" svg:y="5cm"><draw:text-box><text:p>Лид — Кунгур</text:p><text:p>Аналитик — Воронцов</text:p></draw:text-box></draw:frame>
<presentation:notes><draw:frame presentation:class="notes" svg:width="15cm" svg:height="10cm" svg:x="2cm" svg:y="12cm"><draw:text-box><text:p>Представить команду</text:p></draw:text-box></draw:frame></presentation:notes>
</draw:page>
</office:presentation></office:body></office:document>
